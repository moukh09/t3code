.create-merge table ProviderMetrics (Timestamp:datetime, Provider:string, MetricName:string, Value:real, Unit:string, Outcome:string, Stage:string, Operation:string, StopReason:string, InteractionMode:string, RuntimeMode:string, CliVersionBucket:string, CrossedTurnWindow:bool, ToolKind:string, ToolOutcome:string, PermissionRequested:bool, PermissionDecision:string)

.create-merge table ProviderOperations (Timestamp:datetime, Provider:string, Operation:string, Outcome:string, Stage:string, DurationMs:real, ErrorCode:string, AcpErrorCode:string, Retryable:bool, StopReason:string, InteractionMode:string, RuntimeMode:string, ToolKind:string, ToolOutcome:string, PermissionRequested:bool, PermissionDecision:string, UsedTokens:long, ContextSize:long, CliVersionBucket:string, CrossedTurnWindow:bool)

.create-or-alter table ProviderMetrics ingestion json mapping 'ProviderMetricsJsonMapping' '[{"column":"Timestamp","path":"$.Timestamp","datatype":"datetime"},{"column":"Provider","path":"$.Provider","datatype":"string"},{"column":"MetricName","path":"$.MetricName","datatype":"string"},{"column":"Value","path":"$.Value","datatype":"real"},{"column":"Unit","path":"$.Unit","datatype":"string"},{"column":"Outcome","path":"$.Outcome","datatype":"string"},{"column":"Stage","path":"$.Stage","datatype":"string"},{"column":"Operation","path":"$.Operation","datatype":"string"},{"column":"StopReason","path":"$.StopReason","datatype":"string"},{"column":"InteractionMode","path":"$.InteractionMode","datatype":"string"},{"column":"RuntimeMode","path":"$.RuntimeMode","datatype":"string"},{"column":"CliVersionBucket","path":"$.CliVersionBucket","datatype":"string"},{"column":"CrossedTurnWindow","path":"$.CrossedTurnWindow","datatype":"bool"},{"column":"ToolKind","path":"$.ToolKind","datatype":"string"},{"column":"ToolOutcome","path":"$.ToolOutcome","datatype":"string"},{"column":"PermissionRequested","path":"$.PermissionRequested","datatype":"bool"},{"column":"PermissionDecision","path":"$.PermissionDecision","datatype":"string"}]'

.create-or-alter table ProviderOperations ingestion json mapping 'ProviderOperationsJsonMapping' '[{"column":"Timestamp","path":"$.Timestamp","datatype":"datetime"},{"column":"Provider","path":"$.Provider","datatype":"string"},{"column":"Operation","path":"$.Operation","datatype":"string"},{"column":"Outcome","path":"$.Outcome","datatype":"string"},{"column":"Stage","path":"$.Stage","datatype":"string"},{"column":"DurationMs","path":"$.DurationMs","datatype":"real"},{"column":"ErrorCode","path":"$.ErrorCode","datatype":"string"},{"column":"AcpErrorCode","path":"$.AcpErrorCode","datatype":"string"},{"column":"Retryable","path":"$.Retryable","datatype":"bool"},{"column":"StopReason","path":"$.StopReason","datatype":"string"},{"column":"InteractionMode","path":"$.InteractionMode","datatype":"string"},{"column":"RuntimeMode","path":"$.RuntimeMode","datatype":"string"},{"column":"ToolKind","path":"$.ToolKind","datatype":"string"},{"column":"ToolOutcome","path":"$.ToolOutcome","datatype":"string"},{"column":"PermissionRequested","path":"$.PermissionRequested","datatype":"bool"},{"column":"PermissionDecision","path":"$.PermissionDecision","datatype":"string"},{"column":"UsedTokens","path":"$.UsedTokens","datatype":"long"},{"column":"ContextSize","path":"$.ContextSize","datatype":"long"},{"column":"CliVersionBucket","path":"$.CliVersionBucket","datatype":"string"},{"column":"CrossedTurnWindow","path":"$.CrossedTurnWindow","datatype":"bool"}]'
